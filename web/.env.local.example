# Copy to web/.env.local and paste your Google OAuth *Web application* client id.
# Vite inlines this at build time, so restart `npm run dev` after changing it.
#
# The same value must be given to Django as GOOGLE_CLIENT_ID, or the server will
# reject the token as having the wrong audience.
VITE_GOOGLE_CLIENT_ID=685469105004-9c082822jdrd37a7rit4n7usm6alk4g9.apps.googleusercontent.com
